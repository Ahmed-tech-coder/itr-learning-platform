# =========================================================================
# ITR EDUCATION - PRODUCTION-READY GITIGNORE
# Project Stack: React + TypeScript + Vite + Tailwind CSS + Shadcn UI + Vercel
# =========================================================================

# --- Dependency Directories ---
# Ignore dependencies downloaded via npm/yarn/pnpm
node_modules/
jspm_packages/
web_modules/

# --- Build & Distribution Outputs ---
# Ignore compiler and bundler outputs
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.turbo/

# --- Environment and Secret Files ---
# CRITICAL: NEVER commit sensitive environment variables or local configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.local
.env*.local

# --- Log Files ---
# Ignore developer execution logs and package manager dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
access.log
error.log

# --- Diagnostic and Coverage Reports ---
# Ignore automated testing code coverage reports
coverage/
*.lcov
.nyc_output/

# --- Editor and IDE Specific Settings ---
# Ignore system-specific workspaces and editor caching
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# --- OS-specific files ---
# Ignore operating system specific database and index files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Cloud & Hosting Configurations ---
# Ignore local deployment settings for Vercel, Netlify, Serverless, etc.
.vercel/
.serverless/
.netlify/
.expo/
